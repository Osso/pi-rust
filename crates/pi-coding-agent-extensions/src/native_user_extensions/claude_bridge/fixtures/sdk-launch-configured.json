{
  "argv": [
    "--output-format",
    "stream-json",
    "--verbose",
    "--input-format",
    "stream-json",
    "--tools",
    "WebSearch",
    "--permission-mode",
    "bypassPermissions",
    "--include-partial-messages",
    "--model=-custom-model",
    "--settings",
    "{\"autoMemoryEnabled\":true,\"claudeMdExcludes\":[\"**/CLAUDE.md\",\"**/AGENTS.md\",\"**/.claude/rules/**\"],\"includeGitInstructions\":false}"
  ],
  "env": {},
  "cwd": "<cwd>",
  "initialize": {
    "request_id": "<request-id>",
    "type": "control_request",
    "request": {
      "subtype": "initialize",
      "hooks": {
        "PostToolBatch": [
          {
            "hookCallbackIds": [
              "hook_0"
            ]
          }
        ]
      }
    }
  }
}
